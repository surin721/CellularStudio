<Application x:Class="CellularStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CellularStudio"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolToVisibilityConverter x:Key="Vis"/>
            <local:BoolToVisibilityConverter x:Key="InvVis" Invert="True"/>
            <local:InverseBoolConverter x:Key="Not"/>
            <local:HexToBrushConverter x:Key="HexBrush"/>
            <local:RelativeTimeConverter x:Key="RelTime"/>
            <local:EqualityToVisibilityConverter x:Key="PageVis"/>
            <local:StarLengthConverter x:Key="StarLength"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
