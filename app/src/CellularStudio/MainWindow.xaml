<Window x:Class="CellularStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:CellularStudio.Controls"
        xmlns:v="clr-namespace:CellularStudio.Views"
        xmlns:vm="clr-namespace:CellularStudio.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Cellular Studio" Width="1200" Height="780" MinWidth="940" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource UiFont}" FontSize="13.5"
        Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ───────────── Sidebar ───────────── -->
        <Border Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,0,14,16">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,14,0,22">
                    <Border Width="34" Height="34" CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5C7CFA" Offset="0"/>
                                <GradientStop Color="#3B5BDB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC05;" Foreground="White" FontSize="17"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Cellular Studio" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="SMS · USSD · Modem" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Carrier card (bottom) -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="12" Padding="14" Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <c:CarrierBadge Width="34" Height="34" LogoPath="{Binding LogoPath}" Monogram="{Binding Brand.Monogram}"
                                            BrandColor="{Binding Brand.BrandColor}" IsDimmed="{Binding IsOffline}"
                                            ToolTip="{Binding Brand.Name}"/>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CarrierName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding NetworkLabel}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <c:SignalBars Grid.Column="2" Width="22" Height="14" Bars="{Binding SignalBars}" VerticalAlignment="Center"
                                          ActiveBrush="{StaticResource TextPrimary}" ToolTip="{Binding SignalText}"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Border}" Margin="0,12"/>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Warning}" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SignalText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <StackPanel>
                    <TextBlock Text="MENU" Style="{StaticResource Overline}" Margin="12,0,0,8"/>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Overview" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavMessages" Style="{StaticResource NavItem}" Tag="&#xE8BD;" Checked="Nav_Checked">
                        <Grid>
                            <TextBlock Text="Messages"/>
                            <Border HorizontalAlignment="Right" Background="{StaticResource Accent}" CornerRadius="9" MinWidth="20" Height="18"
                                    Padding="6,0" Margin="0,0,4,0"
                                    Visibility="{Binding UnreadTotal, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding UnreadTotal}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavUssd" Style="{StaticResource NavItem}" Tag="&#xE75F;" Content="USSD" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavDevice" Style="{StaticResource NavItem}" Tag="&#xE7F8;" Content="Device" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ───────────── Content ───────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Caption bar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close to tray"/>
            </StackPanel>

            <!-- Offline banner -->
            <Border Grid.Row="1" Margin="32,0,32,8" Padding="14,12" CornerRadius="10"
                    Background="{StaticResource WarningSoft}" BorderBrush="#F3D9A4" BorderThickness="1"
                    Visibility="{Binding IsOffline, Converter={StaticResource Vis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warning}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding NetworkLabel}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OfflineHint}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RefreshCommand}" ToolTip="Read the modem state again">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13"/>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ReconnectCommand}" Margin="6,0,0,0" MinHeight="34" Padding="14,0"
                                ToolTip="Ask the modem to register on the network again">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" Margin="0,0,8,0"
                                                Visibility="{Binding Reconnecting, Converter={StaticResource Vis}}"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="13" Margin="0,0,8,0"
                                           Visibility="{Binding Reconnecting, Converter={StaticResource InvVis}}"/>
                                <TextBlock Text="Reconnect"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pages (kept alive so state survives navigation) -->
            <Grid Grid.Row="2">
                <v:OverviewView Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Overview}"/>
                <v:MessagesView Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Messages}"/>
                <v:UssdView Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=USSD}"/>
                <v:DeviceView Visibility="{Binding CurrentPage, Converter={StaticResource PageVis}, ConverterParameter=Device}"/>
            </Grid>

            <!-- Toasts -->
            <ItemsControl Grid.Row="0" Grid.RowSpan="3" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,24,24" Width="360" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:Toast}">
                        <Border x:Name="toast" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="10" Padding="14,12" Margin="0,8,0,0" Effect="{StaticResource PopShadow}" RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <TranslateTransform Y="0"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="iconBg" Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                                    <TextBlock x:Name="icon" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{StaticResource Accent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,2,0,0"
                                               Visibility="{Binding Message, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="10" Content="&#xE711;"
                                        VerticalAlignment="Top" ToolTip="Dismiss"
                                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Success">
                                <Setter TargetName="iconBg" Property="Background" Value="{StaticResource SuccessSoft}"/>
                                <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Success}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                <Setter TargetName="iconBg" Property="Background" Value="{StaticResource WarningSoft}"/>
                                <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Warning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Error">
                                <Setter TargetName="iconBg" Property="Background" Value="{StaticResource DangerSoft}"/>
                                <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Danger}"/>
                            </DataTrigger>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="toast" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="toast" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="12" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
