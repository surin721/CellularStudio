<UserControl x:Class="CellularStudio.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CellularStudio.ViewModels"
             xmlns:c="clr-namespace:CellularStudio.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}" d:DesignWidth="950" d:DesignHeight="900">
    <UserControl.Resources>
        <DataTemplate x:Key="DetailRowTemplate" DataType="{x:Type vm:DetailRow}">
            <Grid Margin="0,0,0,0" MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Value}"/>
                <Button x:Name="copy" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                        Content="&#xE8C8;" ToolTip="Copy" Visibility="Collapsed"
                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Value}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Copyable}" Value="True">
                    <Setter TargetName="copy" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="CardHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32" MaxWidth="1100">
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Device" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Modem, SIM and network details" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="Modem" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ModemRows}" ItemTemplate="{StaticResource DetailRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="SIM card" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SimRows}" ItemTemplate="{StaticResource DetailRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEC05;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="Network" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding NetworkRows}" ItemTemplate="{StaticResource DetailRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="Capabilities" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding CapabilityRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CapabilityRow}">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="iconBg" Width="24" Height="24" CornerRadius="12" Background="{StaticResource SuccessSoft}" VerticalAlignment="Top">
                                            <TextBlock x:Name="icon" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource Success}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,1,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Supported}" Value="False">
                                            <Setter TargetName="iconBg" Property="Background" Value="{StaticResource DangerSoft}"/>
                                            <Setter TargetName="icon" Property="Text" Value="&#xE711;"/>
                                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Carrier & balance -->
            <Border x:Name="CarrierCard" Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                        <TextBlock Text="Carrier &amp; balance" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>

                    <!-- carrier identity -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <c:CarrierBadge Width="48" Height="48" LogoPath="{Binding LogoPath}" Monogram="{Binding Brand.Monogram}"
                                        BrandColor="{Binding Brand.BrandColor}"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Brand.Name}" FontSize="16" FontWeight="SemiBold"/>
                                <Border x:Name="MethodPill" Style="{StaticResource Pill}" Margin="10,0,0,0" Padding="9,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="MethodPillText" Text="{Binding CarrierMethodStatus}" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                <Run Text="Network"/> <Run Text="{Binding Brand.Id, Mode=OneWay}"/>
                                <Run Text="{Binding CarrierMenuCodes, Mode=OneWay, StringFormat=  ·  {0}}"/>
                                <Run Text="{Binding CarrierHelpline, Mode=OneWay, StringFormat=  ·  {0}}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ChooseLogoCommand}" MinHeight="32" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Choose logo…"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Remove" Margin="6,0,0,0" Command="{Binding RemoveLogoCommand}"
                                    Visibility="{Binding HasLogo, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding CarrierHint}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,14,0,0"/>

                    <!-- balance SMS method -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BALANCE SMS TO" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource InputBox}" Tag="Short number" FontFamily="{StaticResource MonoFont}"
                                     x:Name="CarrierNumberBox" Text="{Binding CarrierSmsNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="MESSAGE TEXT" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource InputBox}" Tag="Keyword, e.g. BAL" FontFamily="{StaticResource MonoFont}"
                                     Text="{Binding CarrierSmsText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="ACCEPT REPLIES FROM" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource InputBox}" Tag="Sender names, comma separated"
                                     Text="{Binding CarrierSenderIds, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Messages from these senders that look like a balance statement update the Overview tiles."/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCarrierSettingsCommand}" MinWidth="90"/>
                        <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding CheckBalanceCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="Check balance now"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Content="Reset to default" Margin="8,0,0,0" Command="{Binding ResetCarrierSettingsCommand}"
                                Visibility="{Binding CarrierHasOverride, Converter={StaticResource Vis}}"/>
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding OpenCarrierWebsiteCommand}"
                                Visibility="{Binding Brand.Website, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Operator website"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- App settings -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                        <TextBlock Text="App" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunAtStartup}">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold"/>
                            <TextBlock Text="Starts hidden at sign-in with only the tray icon, so incoming SMS are never missed."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Height="1" Background="{StaticResource Border}" Margin="0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,0,8,0"/>
                        <TextBlock Text="Closing the window keeps Cellular Studio running in the system tray. Use Exit in the tray menu to quit."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="12.5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Activity log -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                        <TextBlock Text="Activity" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <Border Background="{StaticResource SubtleBg}" CornerRadius="8" Padding="12,8">
                        <ItemsControl ItemsSource="{Binding ActivityLog}" MaxHeight="260">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LogEntry}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextTertiary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
