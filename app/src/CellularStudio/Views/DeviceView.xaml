<UserControl x:Class="CellularStudio.Views.DeviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CellularStudio.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}" d:DesignWidth="950" d:DesignHeight="900">
    <UserControl.Resources>
        <DataTemplate x:Key="DetailRowTemplate" DataType="{x:Type vm:DetailRow}">
            <Grid Margin="0,0,0,0" MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Value}"/>
                <Button x:Name="copy" Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12"
                        Content="&#xE8C8;" ToolTip="Copy" Visibility="Collapsed"
                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Value}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Copyable}" Value="True">
                    <Setter TargetName="copy" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="CardHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32" MaxWidth="1100">
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Device" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Modem, SIM and network details" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F8;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="Modem" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ModemRows}" ItemTemplate="{StaticResource DetailRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="SIM card" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SimRows}" ItemTemplate="{StaticResource DetailRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEC05;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="Network" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding NetworkRows}" ItemTemplate="{StaticResource DetailRowTemplate}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource CardHeader}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="Capabilities" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding CapabilityRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CapabilityRow}">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="iconBg" Width="24" Height="24" CornerRadius="12" Background="{StaticResource SuccessSoft}" VerticalAlignment="Top">
                                            <TextBlock x:Name="icon" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource Success}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,1,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Supported}" Value="False">
                                            <Setter TargetName="iconBg" Property="Background" Value="{StaticResource DangerSoft}"/>
                                            <Setter TargetName="icon" Property="Text" Value="&#xE711;"/>
                                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Danger}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- App settings -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                        <TextBlock Text="App" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RunAtStartup}">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold"/>
                            <TextBlock Text="Starts hidden at sign-in with only the tray icon, so incoming SMS are never missed."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <Border Height="1" Background="{StaticResource Border}" Margin="0,14"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,0,8,0"/>
                        <TextBlock Text="Closing the window keeps Cellular Studio running in the system tray. Use Exit in the tray menu to quit."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="12.5"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Activity log -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource CardHeader}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
                        <TextBlock Text="Activity" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>
                    <Border Background="{StaticResource SubtleBg}" CornerRadius="8" Padding="12,8">
                        <ItemsControl ItemsSource="{Binding ActivityLog}" MaxHeight="260">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LogEntry}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextTertiary}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
