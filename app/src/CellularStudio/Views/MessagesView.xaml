<UserControl x:Class="CellularStudio.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CellularStudio.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}" d:DesignWidth="950" d:DesignHeight="740">
    <Border Style="{StaticResource Card}" Margin="32,4,32,32" Padding="0" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- ───── Conversation list ───── -->
            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,18,14,12">
                    <Grid DockPanel.Dock="Top" Margin="6,0,0,14">
                        <TextBlock Text="Messages" Style="{StaticResource PageTitle}" FontSize="22"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Read messages from the modem"
                                    Command="{Binding SyncStoreCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" Padding="12,0" MinHeight="34" Margin="6,0,0,0"
                                    Command="{Binding NewMessageCommand}" ToolTip="New message (Ctrl+N)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Foreground="White" Margin="0,0,6,0"/>
                                    <TextBlock Text="New"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBox Style="{StaticResource InputBox}" Tag="Search messages" Padding="34,8,10,8"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource TextTertiary}"
                                   HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False"/>
                    </Grid>

                    <Grid>
                        <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding ConversationView}"
                                 SelectedItem="{Binding SelectedConversation}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Conversation}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="avatar" Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentSoft}">
                                            <Grid>
                                                <TextBlock x:Name="initials" Text="{Binding Initials}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="person" Style="{StaticResource Icon}" Text="&#xE77B;" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock x:Name="name" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,56,0"/>
                                                <TextBlock Text="{Binding LastTime, Converter={StaticResource RelTime}, ConverterParameter=short}"
                                                           Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,3,0,0">
                                                <TextBlock x:Name="preview" Text="{Binding Preview}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,28,0"/>
                                                <Border HorizontalAlignment="Right" Background="{StaticResource Accent}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                                        Visibility="{Binding Unread, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsService}" Value="False">
                                            <Setter TargetName="initials" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="person" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsService}" Value="True">
                                            <Setter TargetName="avatar" Property="Background" Value="#FFF1E3"/>
                                            <Setter TargetName="initials" Property="Foreground" Value="#C2610C"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Unread, Converter={StaticResource Vis}}" Value="Visible">
                                            <Setter TargetName="preview" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0"
                                    Visibility="{Binding Conversations.Count, Converter={StaticResource InvVis}}">
                            <TextBlock Text="No conversations" Style="{StaticResource Body}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sent and received SMS appear here" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ───── Empty state ───── -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasThread, Converter={StaticResource InvVis}}">
                <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource AccentSoft}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="28" Foreground="{StaticResource Accent}"/>
                </Border>
                <TextBlock Text="Select a conversation" Style="{StaticResource SectionTitle}" FontSize="17" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                <TextBlock Text="or start a new one to send an SMS" Style="{StaticResource Body}" HorizontalAlignment="Center"/>
                <Button Style="{StaticResource PrimaryButton}" Content="New message" Margin="0,18,0,0" HorizontalAlignment="Center"
                        Command="{Binding NewMessageCommand}"/>
            </StackPanel>

            <!-- ───── Thread ───── -->
            <DockPanel Grid.Column="1" Visibility="{Binding HasThread, Converter={StaticResource Vis}}">
                <!-- Thread header -->
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="22,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ThreadTitle}" Style="{StaticResource SectionTitle}" FontSize="16"/>
                            <TextBlock Text="{Binding ThreadSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy number"
                                    Command="{Binding CopyCommand}" CommandParameter="{Binding SelectedConversation.Address}"
                                    Visibility="{Binding IsComposingNew, Converter={StaticResource InvVis}}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete conversation"
                                    Command="{Binding DeleteConversationCommand}" CommandParameter="{Binding SelectedConversation}"
                                    Visibility="{Binding IsComposingNew, Converter={StaticResource InvVis}}"/>
                            <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelNewMessageCommand}"
                                    Visibility="{Binding IsComposingNew, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Recipient (new message) -->
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="22,12"
                        Visibility="{Binding IsComposingNew, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <TextBlock Text="To" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBox x:Name="RecipientBox" Style="{StaticResource InputBox}" Tag="Phone number, e.g. 071 234 5678"
                                 Text="{Binding NewRecipient, UpdateSourceTrigger=PropertyChanged}" InputScope="TelephoneNumber"/>
                    </DockPanel>
                </Border>

                <!-- Composer -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18,14"
                        Visibility="{Binding CanReply, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="ComposeBox" Style="{StaticResource InputBox}" Tag="Write a message…"
                                     Text="{Binding ComposeText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="False" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                     Padding="12,10,110,10" PreviewKeyDown="ComposeBox_PreviewKeyDown"/>
                            <TextBlock Text="{Binding ComposeCounter}" Style="{StaticResource Caption}" FontSize="11.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,11" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Width="44" Height="40" Padding="0"
                                VerticalAlignment="Bottom" Command="{Binding SendMessageCommand}" ToolTip="Send (Enter)">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Foreground="White"
                                           Visibility="{Binding IsSending, Converter={StaticResource InvVis}}"/>
                                <ContentControl Style="{StaticResource Spinner}" Foreground="White"
                                                Visibility="{Binding IsSending, Converter={StaticResource Vis}}"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="22,14"
                        Background="{StaticResource SubtleBg}" Visibility="{Binding CanReply, Converter={StaticResource InvVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{StaticResource TextTertiary}" Margin="0,0,8,0"/>
                        <TextBlock Text="This sender uses a name instead of a number, so it can't receive replies." Style="{StaticResource Body}" FontSize="12.5"/>
                    </StackPanel>
                </Border>

                <!-- Bubbles -->
                <ScrollViewer x:Name="ThreadScroll" VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <ItemsControl x:Name="ThreadItems" ItemsSource="{Binding SelectedConversation.Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MessageItem}">
                                <StackPanel x:Name="row" HorizontalAlignment="Left" Margin="0,4" MaxWidth="520">
                                    <Border x:Name="bubble" Background="{StaticResource BubbleIn}" CornerRadius="16,16,16,4" Padding="14,9">
                                        <TextBox x:Name="text" Text="{Binding Body, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                                 TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}" FontSize="14" Padding="0"
                                                 SelectionBrush="{StaticResource Accent}" Cursor="IBeam"/>
                                    </Border>
                                    <StackPanel x:Name="meta" Orientation="Horizontal" Margin="6,4,6,0" HorizontalAlignment="Left">
                                        <TextBlock x:Name="status" Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="11.5" TextWrapping="Wrap"/>
                                        <Button x:Name="retry" Style="{StaticResource GhostButton}" Content="Retry" Padding="6,0" MinHeight="20" FontSize="11.5"
                                                Foreground="{StaticResource Accent}" Margin="6,0,0,0" Visibility="Collapsed"
                                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                        <Setter TargetName="row" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="bubble" Property="Background" Value="{StaticResource BubbleOut}"/>
                                        <Setter TargetName="bubble" Property="CornerRadius" Value="16,16,4,16"/>
                                        <Setter TargetName="text" Property="Foreground" Value="White"/>
                                        <Setter TargetName="text" Property="SelectionBrush" Value="White"/>
                                        <Setter TargetName="meta" Property="HorizontalAlignment" Value="Right"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                        <Setter TargetName="bubble" Property="Background" Value="{StaticResource DangerSoft}"/>
                                        <Setter TargetName="text" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter TargetName="status" Property="Foreground" Value="{StaticResource Danger}"/>
                                        <Setter TargetName="retry" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Sending">
                                        <Setter TargetName="bubble" Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
