<UserControl x:Class="CellularStudio.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:CellularStudio.Controls"
             xmlns:vm="clr-namespace:CellularStudio.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}" d:DesignWidth="950" d:DesignHeight="740">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32" MaxWidth="1100">

            <!-- Header -->
            <TextBlock Text="Overview" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Your SIM, network and balance at a glance" Style="{StaticResource Body}" Margin="0,4,0,22"/>

            <!-- Carrier hero -->
            <Border Style="{StaticResource Card}" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <c:CarrierBadge Width="56" Height="56" LogoPath="{Binding LogoPath}" Monogram="{Binding Brand.Monogram}"
                                    BrandColor="{Binding Brand.BrandColor}" IsDimmed="{Binding IsOffline}"/>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CarrierName}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                            <Border x:Name="StatusPill" Style="{StaticResource Pill}" Margin="12,0,0,0" VerticalAlignment="Center" Padding="9,3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="PillDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="PillText" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding NetworkLabel}" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0">
                            <Run Text="{Binding Status.Model, Mode=OneWay}"/><Run Text="  ·  SIM "/><Run Text="{Binding Status.SimSpn, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <c:SignalBars Width="30" Height="20" Bars="{Binding SignalBars}" ActiveBrush="{StaticResource Accent}"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Margin="10,0,0,0" ToolTip="Refresh status"
                                    Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SignalText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,6,44,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Balance -->
            <Grid Margin="0,30,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="Balance" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="{Binding BalanceUpdatedText}" Style="{StaticResource Caption}" Margin="10,0,0,1" VerticalAlignment="Bottom"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Command="{Binding CheckBalanceCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" Margin="0,0,8,0"
                                        Visibility="{Binding BalanceBusy, Converter={StaticResource Vis}}"/>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"
                                   Visibility="{Binding BalanceBusy, Converter={StaticResource InvVis}}"/>
                        <TextBlock Text="Check balance"/>
                    </StackPanel>
                </Button>
            </Grid>

            <UniformGrid Columns="3" Margin="-8,0">
                <!-- Credit -->
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CREDIT" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentSoft}" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" FontSize="14" Foreground="{StaticResource Accent}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding CreditText}" Style="{StaticResource StatValue}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding CreditDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Data -->
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="DATA" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource SuccessSoft}" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="14" Foreground="{StaticResource Success}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding DataText}" Style="{StaticResource StatValue}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding DataDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0" ToolTip="{Binding DataDetail}"/>
                    </StackPanel>
                </Border>
                <!-- Validity -->
                <Border Style="{StaticResource Card}" Margin="8,0" Padding="20,18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="VALID UNTIL" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource WarningSoft}" HorizontalAlignment="Right">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="14" Foreground="{StaticResource Warning}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding ValidityText}" Style="{StaticResource StatValue}" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding ValidityDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Data packages -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16"
                    Visibility="{Binding HasDataPackages, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="DATA PACKAGES" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding DataPackages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DataPackageRow}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                    <!-- share of total data -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center" Height="6" Margin="0,0,16,0">
                                        <Border Background="{StaticResource SubtleBg}" CornerRadius="3"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding BarShare, Converter={StaticResource StarLength}}"/>
                                                <ColumnDefinition Width="{Binding BarShare, Converter={StaticResource StarLength}, ConverterParameter=rest}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="bar" Background="{StaticResource Success}" CornerRadius="3"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{Binding Amount}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="phrase" Text="{Binding ExpiryPhrase}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock Text="{Binding ExpiryDate}" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ExpiringSoon}" Value="True">
                                        <Setter TargetName="phrase" Property="Foreground" Value="{StaticResource Warning}"/>
                                        <Setter TargetName="bar" Property="Background" Value="{StaticResource Warning}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Operator reply -->
            <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="10" Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    Visibility="{Binding HasBalance, Converter={StaticResource Vis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LAST OPERATOR REPLY" Style="{StaticResource Overline}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding BalanceRaw}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                               Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Quick actions -->
            <TextBlock Text="Quick actions" Style="{StaticResource SectionTitle}" Margin="0,30,0,12"/>
            <UniformGrid Columns="3" Margin="-6,0">
                <Button Style="{StaticResource ActionTile}" Margin="6,0" Command="{Binding CheckBalanceCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentSoft}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Foreground="{StaticResource Accent}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="Check balance" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding BalanceMethodText}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource ActionTile}" Margin="6,0" Command="{Binding OpenServicesMenuCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#F3EEFF">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" Foreground="#7048E8"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="Services menu" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding Brand.MenuCode, StringFormat=Opens {0}}" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource ActionTile}" Margin="6,0" Command="{Binding NewMessageCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource SuccessSoft}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" Foreground="{StaticResource Success}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="New message" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Send an SMS" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="11" Foreground="{StaticResource TextTertiary}"/>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Recent conversations -->
            <Grid Margin="0,30,0,12">
                <TextBlock Text="Recent messages" Style="{StaticResource SectionTitle}"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Content="View all"
                        Command="{Binding NavigateCommand}" CommandParameter="Messages"/>
            </Grid>
            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ItemsControl ItemsSource="{Binding ConversationView}" MaxHeight="300">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Conversation}">
                                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="10,9"
                                        Click="OpenConversation_Click" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentSoft}">
                                            <TextBlock Text="{Binding Initials}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}" FontSize="12.5"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding LastTime, Converter={StaticResource RelTime}, ConverterParameter=short}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel HorizontalAlignment="Center" Margin="0,22" Visibility="{Binding Conversations.Count, Converter={StaticResource InvVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="22" Foreground="{StaticResource TextTertiary}"/>
                        <TextBlock Text="No messages yet" Style="{StaticResource Body}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
